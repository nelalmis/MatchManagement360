# ============================================
# .env.production
# ============================================
ENV=production
APP_NAME=Macever
APP_VERSION=1.0.0
BUNDLE_ID=com.macever

# API
API_BASE_URL=https://api.maczamani.com

# Firebase (Production)
FIREBASE_API_KEY=your-prod-api-key
FIREBASE_AUTH_DOMAIN=mac-zamani.firebaseapp.com
FIREBASE_PROJECT_ID=mac-zamani
FIREBASE_STORAGE_BUCKET=mac-zamani.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abcdef
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_REGION=europe-west1

# Firebase Emulator (disabled)
USE_FIREBASE_EMULATOR=false

# Features
ENABLE_DEBUG=false
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=true

# Logging
ENABLE_CONSOLE_LOGS=false
ENABLE_API_LOGS=false
ENABLE_PERFORMANCE_LOGS=false