# ============================================
# .env.staging - Staging Environment
# ============================================
ENV=staging
APP_NAME=Maç Zamanı (Staging)
APP_VERSION=1.0.0
BUNDLE_ID=com.mac.zamani.staging

# API Configuration (Staging)
API_BASE_URL=https://staging-api.maczamani.com
API_TIMEOUT=30000

# Firebase Configuration (Staging)
FIREBASE_API_KEY=your-staging-api-key
FIREBASE_AUTH_DOMAIN=your-project-staging.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-staging
FIREBASE_STORAGE_BUCKET=your-project-staging.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abcdef-staging
FIREBASE_MEASUREMENT_ID=G-STAGING-XXX
FIREBASE_REGION=europe-west1

# Firebase Emulator (disabled for staging)
USE_FIREBASE_EMULATOR=false

# Platform Specific
ANDROID_EMULATOR_HOST=10.0.2.2
IOS_EMULATOR_HOST=localhost

# Features
ENABLE_DEBUG=true
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=true

# Logging
ENABLE_CONSOLE_LOGS=true
ENABLE_API_LOGS=true
ENABLE_PERFORMANCE_LOGS=true
```

---

## 📁 Tüm .env Dosyaların Şöyle Olmalı:
```
project-root/
├── .env                    # Default (development)
├── .env.local             # Local overrides (gitignore'da)
├── .env.staging           # Staging environment
└── .env.production        # Production environment